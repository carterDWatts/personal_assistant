# Copy to .env with mode 0600. Generate a password with openssl rand -hex 32.
POSTGRES_PASSWORD=
# Run python3 keys.py to generate these; never copy example/default JWTs.
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
PUBLIC_URL=
# Put the Google client ID and secret in .auth.env, as documented.
GOOGLE_LOGIN_ENABLED=false
# Email sign-in stays disabled until these point to a real mail transport.
EMAIL_LOGIN_ENABLED=false
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
